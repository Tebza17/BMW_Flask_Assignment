# Copy this file to scripts/config.env and fill your values.
# Do not place long-lived secrets in this file. Prefer GitHub Secrets and AWS OIDC for pipeline runs.
AWS_REGION=us-east-1
# Optional: if empty, scripts auto-detect via `aws sts get-caller-identity`
AWS_ACCOUNT_ID=
CLUSTER_NAME=devops-assessment-eks
ECR_REPOSITORY_NAME=flask-kafka-app
IMAGE_TAG=0.1.0
K8S_NAMESPACE=assessment
HELM_RELEASE_NAME=flask-kafka-app
NODE_TYPE=t3.medium
NODE_COUNT=2
GIT_REPO_URL=https://github.com/Tebza17/BMW_Flask_Assignment.git
